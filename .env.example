# Supabase credentials for the live (shared) version.
# Copy this file to .env and fill in the values from your project's
# Project Settings -> API page. See SUPABASE_SETUP.md for the full walkthrough.
#
# Leave this file uncopied to run the app entirely from localStorage instead,
# which is fine for local development.
#
# Both values below are PUBLIC. The anon key is embedded in the browser bundle by
# design; RLS policies are what protect the data. Never put the service_role key
# in here — it bypasses every policy.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
